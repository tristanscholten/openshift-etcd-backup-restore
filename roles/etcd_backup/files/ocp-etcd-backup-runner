#!/usr/bin/env bash
# Runs only from a root-owned systemd unit. Never deletes incomplete sets.
set -euo pipefail

root=${1:?managed root required}
vendor=${2:?vendor script required}
validator=${3:?validator required}
user_home=${OCP_ETCD_BACKUP_USER_HOME:-/home/core}
[[ $user_home == /* && $user_home != *'..'* ]] || { echo 'unsafe configured user home' >&2; exit 64; }
[[ $root == "$user_home"/* && $root != *'..'* ]] || { echo 'unsafe managed root' >&2; exit 64; }
[[ -d $root && ! -L $root && -x $vendor && -x $validator ]] || { echo 'unsafe root or executable' >&2; exit 65; }
: "${OCP_ETCD_BACKUP_VERSION:?set exact OCP 4.20.z version}"
: "${OCP_ETCD_BACKUP_CLUSTER_ID:?set cluster ID}"
[[ $OCP_ETCD_BACKUP_VERSION =~ ^4\.20\.[0-9]+$ ]] || { echo 'unsupported OCP version' >&2; exit 66; }

umask 077
# A corrupt previously complete set makes retention unsafe; fail before creating a fourth set.
while IFS= read -r existing_set; do
  "$validator" "$root" "$existing_set" >/dev/null || { echo 'refuse backup with invalid complete set' >&2; exit 70; }
done < <(find "$root" -mindepth 1 -maxdepth 1 -type d -name 'set-*' -printf '%f\n' | sort)
id="set-$(date -u +%Y%m%dT%H%M%SZ)"
stage="$root/.staging-$id-$$"
final="$root/$id"
trap 'rm -rf -- "$stage"' EXIT
mkdir -m 0700 "$stage"
"$vendor" "$stage"
mapfile -t snapshots < <(find "$stage" -maxdepth 1 -type f -name 'snapshot_*.db' -printf '%f\n')
mapfile -t archives < <(find "$stage" -maxdepth 1 -type f -name 'static_kuberesources_*.tar.gz' -printf '%f\n')
[[ ${#snapshots[@]} -eq 1 && ${#archives[@]} -eq 1 ]] || { echo 'vendor did not create one backup pair' >&2; exit 67; }
ts=${snapshots[0]#snapshot_}; ts=${ts%.db}
[[ ${archives[0]} == "static_kuberesources_${ts}.tar.gz" ]] || { echo 'mismatched backup timestamps' >&2; exit 68; }
[[ -f "$stage/${snapshots[0]}" && ! -L "$stage/${snapshots[0]}" && -f "$stage/${archives[0]}" && ! -L "$stage/${archives[0]}" ]] || { echo 'unsafe backup member' >&2; exit 69; }
(cd "$stage" && sha256sum "${snapshots[0]}" "${archives[0]}") > "$stage/SHA256SUMS"
printf '{"schema":1,"set_id":"%s","timestamp":"%s","ocp_version":"%s","cluster_id":"%s","snapshot":"%s","static_resources":"%s"}\n' \
  "$id" "$ts" "$OCP_ETCD_BACKUP_VERSION" "$OCP_ETCD_BACKUP_CLUSTER_ID" "${snapshots[0]}" "${archives[0]}" > "$stage/metadata.json"
chmod 0600 "$stage"/*
mv -- "$stage" "$final"
touch "$final/COMPLETE"; chmod 0600 "$final/COMPLETE"
trap - EXIT

mapfile -t complete < <(find "$root" -mindepth 1 -maxdepth 1 -type d -name 'set-*' -printf '%f\n' | sort)
# Fail closed before pruning: a corrupt candidate cannot be treated as retained.
for set_id in "${complete[@]}"; do
  "$validator" "$root" "$set_id" >/dev/null || { echo 'refuse retention with invalid complete set' >&2; exit 70; }
done
if (( ${#complete[@]} > 3 )); then
  for set_id in "${complete[@]:0:${#complete[@]}-3}"; do
    target="$root/$set_id"
    [[ -d $target && ! -L $target && $target == "$root"/set-* ]] || { echo 'unsafe prune target' >&2; exit 71; }
    rm -rf -- "$target"
  done
fi
